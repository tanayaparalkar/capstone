# SentinelAI - example environment configuration
#
# Copy this file and fill in the values you want. Everything here is optional:
# with none of it set, `sentinelai scan` runs the deterministic core pipeline
# (Semgrep, Bandit, GitLeaks -> correlation -> statistics -> report) and exits 0.
#
# ---------------------------------------------------------------------------
# IMPORTANT: this file is NOT read automatically.
# ---------------------------------------------------------------------------
# SentinelAI reads os.environ directly (sentinelai/ai/config.py) and does not
# depend on python-dotenv, so simply creating a .env file has no effect. Load it
# into your shell before running the CLI:
#
#     set -a; source .env; set +a
#     python -m sentinelai.main scan .
#
# or export the variables individually. If you keep a real .env with values in
# it, put it at sentinelai-cli/.env - that path is already covered by
# sentinelai-cli/.gitignore. A .env at the repository root is NOT ignored.
#
# ---------------------------------------------------------------------------
# NO API KEYS ARE REQUIRED OR SUPPORTED on this branch.
# ---------------------------------------------------------------------------
# Ollama is the only inference provider implemented here. It runs locally, needs
# no credential, and nothing in this checkout reads an API key for any hosted
# service. There is deliberately no GEMINI_API_KEY or GROK_API_KEY below: adding
# one would imply an integration that does not exist. Every variable listed here
# is read by sentinelai/ai/config.py.


# --- AI enrichment: both required to switch it on -------------------------
# Leave both unset to run scanners only. They must name two DIFFERENT Ollama
# models - a generation model and a dedicated embedding model. Setting both to
# the same value makes Ollama reject the embedding request with HTTP 501.
# Pull them first:  ollama pull llama3.1:8b  &&  ollama pull nomic-embed-text
SENTINELAI_AI_LLM_MODEL=
SENTINELAI_AI_EMBEDDING_MODEL=

# --- Ollama endpoint ------------------------------------------------------
# Must be a loopback address. SentinelAI sends repository source excerpts here
# for embedding, so a non-local host is refused with exit code 2
# (sentinelai/ai/local_endpoint.py). Accepted: localhost, 127.0.0.0/8, [::1].
# Leave unset to use the default shown.
# SENTINELAI_AI_LLM_HOST=http://localhost:11434

# --- Retrieval ------------------------------------------------------------
# How many knowledge-base entries are retrieved per finding. Default 5.
# SENTINELAI_AI_RETRIEVAL_TOP_K=5

# How many source lines around a finding are included as context. Default 20.
# SENTINELAI_AI_CODE_CONTEXT_LINES=20

# --- Confidence scoring ---------------------------------------------------
# Score boundaries for the high / medium / low label. Medium must be lower
# than high. Defaults 0.75 and 0.4.
# SENTINELAI_AI_CONFIDENCE_HIGH_THRESHOLD=0.75
# SENTINELAI_AI_CONFIDENCE_MEDIUM_THRESHOLD=0.4

# --- Verification ---------------------------------------------------------
# The deterministic grounding check. Set to false to report every enrichment as
# unverified instead. Default true.
# SENTINELAI_AI_ENABLE_VERIFICATION=true

# --- Transport ------------------------------------------------------------
# Per-attempt timeout in seconds for each Ollama request. Default 120.0.
# Raise it for a slow machine or a larger model.
# SENTINELAI_AI_REQUEST_TIMEOUT_SECONDS=120.0

# Total attempts per request, including the first; 1 disables retrying.
# Only transient failures are retried. Default 2.
# SENTINELAI_AI_MAX_ATTEMPTS=2

# --- Logging --------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL. Default INFO.
# SENTINELAI_AI_LOG_LEVEL=INFO

# --- Reserved -------------------------------------------------------------
# These two fields exist in AISettings but nothing reads them yet: there is one
# concrete implementation of each. They are listed for completeness only, and
# setting them changes no behaviour on this branch.
# SENTINELAI_AI_LLM_PROVIDER=
# SENTINELAI_AI_EMBEDDING_PROVIDER=
